  <!-- The LFXE baked-key header is generated + gitignored (docs/dts_encryption.md).
       Mirrors ensure_baked_key in build_linux.sh: derive it from config\dts_key.bin,
       generating a fresh key the first time. Needs Python 3 on PATH. -->
  <PropertyGroup>
    <LifxRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..'))</LifxRoot>
    <LfxeKeyHeader>$(LifxRoot)\source\core\crypto\lfxe_key_data.h</LfxeKeyHeader>
    <LfxeKeyFile>$(LifxRoot)\config\dts_key.bin</LfxeKeyFile>
  </PropertyGroup>
  <Target Name="GenerateLfxeKeyHeader" BeforeTargets="ClCompile" Condition="!Exists('$(LfxeKeyHeader)')">
    <PropertyGroup>
      <LfxeKeyArgs Condition="Exists('$(LfxeKeyFile)')">--key-in "$(LfxeKeyFile)"</LfxeKeyArgs>
      <LfxeKeyArgs Condition="!Exists('$(LfxeKeyFile)')">--new --key-out "$(LfxeKeyFile)"</LfxeKeyArgs>
      <LfxeKeyCmd>"$(LifxRoot)\scripts\gen_baked_key.py" $(LfxeKeyArgs)</LfxeKeyCmd>
    </PropertyGroup>
    <Exec Command="where py &gt;nul 2&gt;nul &amp;&amp; (py -3 $(LfxeKeyCmd)) || (python $(LfxeKeyCmd))" ContinueOnError="true" />
    <Error Condition="!Exists('$(LfxeKeyHeader)')" Text="Could not generate $(LfxeKeyHeader). Install Python 3 and rebuild, or run from the repo root: python scripts\gen_baked_key.py --new --key-out config\dts_key.bin" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
